# Exemple de fichier .env
# Copiez ce fichier vers .env et modifiez les valeurs

# Votre domaine principal (sans protocole)
DOMAIN=example.com

# E-mail utilisé par Caddy pour les notifications ACME (obligatoire)
EMAIL=admin@example.com

# Resend: clé secrète utilisée uniquement par l'API
RESEND_API_KEY=re_xxxxxxxxx

# Cloudflare Turnstile: la site key est publique et intégrée au build frontend
TURNSTILE_SITE_KEY=0x4AAAAAAAAxxxxxxxxxxxxxxxxx

# La secret key reste exclusivement sur le serveur
TURNSTILE_SECRET_KEY=0x4AAAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pour le développement local, utilisez:
# DOMAIN=localhost
# EMAIL=dev@localhost
