{
	"name": "frontend",
	"version": "1.0.0",
	"type": "module",
	"dependencies": {
		"@marsidev/react-turnstile": "1.6.1",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-router-dom": "7.18.3"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --report-unused-disable-directives --max-warnings 0",
		"qa:console-check": "grep -r \"console\\.\" src/ --include=\"*.ts\" --include=\"*.tsx\" && exit 1 || exit 0",
		"qa:todo-check": "grep -r \"TODO\\|FIXME\\|HACK\" src/ --include=\"*.ts\" --include=\"*.tsx\" || exit 0"
	},
	"devDependencies": {
		"@types/node": "20.19.43",
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "4.7.0",
		"autoprefixer": "10.5.4",
		"eslint": "8.57.1",
		"eslint-plugin-react": "7.37.5",
		"i18next": "23.16.8",
		"postcss": "8.5.26",
		"react-i18next": "13.5.0",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"typescript-eslint": "7.18.0",
		"vite": "6.4.3",
		"vite-plugin-svgr": "4.5.0"
	},
	"engines": {
		"node": "24.22.3",
		"npm": "11.19.1"
	},
	"packageManager": "npm@11.19.1"
}
